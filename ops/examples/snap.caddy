# Review-only site fragment for the Go dokitool backend (127.0.0.1:9080).
# Merge into the existing Caddy configuration; never replace the fleet Caddyfile.
# Pair with `dokitool serve -listen 127.0.0.1:9080 -client-identity caddy` and
# inject SNAP_INGRESS_KEY from a restricted service environment file so
# X-DokiTool-Client-IP and X-DokiTool-Edge-Key authenticate this loopback hop.
# `{remote_host}` below assumes Caddy accepts visitor connections directly; if
# Caddy sits behind a CDN or load balancer, configure `trusted_proxies` in the
# global `servers` block and pass `{client_ip}` instead of `{remote_host}` so
# all visitors are not collapsed onto the proxy's IP.
snap.example.com {
    @api path /api/downloads/tbvideo-result /api/parse /api/resolve /api/platforms /api/short_videos /api/douyin /api/ksjx /api/bilibili /api/xhsjx /api/toutiao /api/youtube/context /api/youtube/finalize /api/stats
    @shanghai path /internal/shanghai/claim /internal/shanghai/result
    @compress not path /api/media/weibo /internal/shanghai/claim /internal/shanghai/result
    @source path *.php /backend/* /internal/* /ops/* /.git/* /.env*
    # Preserve ordering: Caddy otherwise sorts handle before route.
    route {
    # This file MUST exist. The supplied example fails closed until access is decided.
    import /etc/caddy/snap-access.caddy
    encode @compress zstd gzip
    header X-Content-Type-Options nosniff
    header Referrer-Policy no-referrer
    header Strict-Transport-Security "max-age=31536000"
    header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
    # The download bridge is a same-origin iframe, not a public embedding surface.
    # Mutually exclusive setters avoid duplicate or conflicting framing and CSP headers.
    @monitor path /monitor /monitor.html
    @download_bridge path /downloads/bridge.html
    @not_download_bridge not path /downloads/bridge.html
    @default_csp not path /monitor /monitor.html /downloads/bridge.html
    header @download_bridge X-Frame-Options SAMEORIGIN
    header @not_download_bridge X-Frame-Options DENY
    header @download_bridge Content-Security-Policy "default-src 'none'; script-src 'self'; connect-src 'self'; worker-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'self'"
    header @default_csp Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-lU5QEegjpHofhq3MItVD2EtdZznktPh4EX6foieDHns='; style-src 'self' 'unsafe-inline'; img-src 'self' https: http: data: blob:; media-src 'self' https: http: blob:; connect-src 'self' https: http:; worker-src 'self'; frame-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
    # A 304 cannot replace Chromium's previously cached X-Frame-Options: DENY.
    # Return the small bridge document in full without touching Worker caching.
    request_header @download_bridge -If-None-Match
    request_header @download_bridge -If-Modified-Since

    # Exact signed-media endpoint: Go streaming relay, no response buffering/compression.
    handle /api/media/weibo {
        reverse_proxy 127.0.0.1:9080 {
            flush_interval -1
            header_up X-DokiTool-Client-IP {remote_host}
            header_up X-DokiTool-Edge-Key {env.SNAP_INGRESS_KEY}
            transport http {
                read_timeout 310s
                write_timeout 310s
            }
        }
    }
    handle @api {
        reverse_proxy 127.0.0.1:9080 {
            header_up X-DokiTool-Client-IP {remote_host}
            header_up X-DokiTool-Edge-Key {env.SNAP_INGRESS_KEY}
        }
    }
    # Outbound-pull Shanghai control plane: exact paths before @source blocks /internal/*.
    handle @shanghai {
        reverse_proxy 127.0.0.1:9080 {
            flush_interval -1
            header_up X-DokiTool-Client-IP {remote_host}
            header_up X-DokiTool-Edge-Key {env.SNAP_INGRESS_KEY}
        }
    }
    handle /api/* {
        header Content-Type "application/json; charset=utf-8"
        header Cache-Control "no-store"
        respond `{"schema_version":"1.0","code":"INVALID_INPUT","error":{"code":"INVALID_INPUT","message":"接口不存在"}}` 404
    }
    handle @source {
        respond 404
    }
    # Only the download Worker handles /downloads/file/* while active.
    # Missing scripts or expired handoff URLs must never become the SPA homepage.
    handle /downloads/* {
        root * /srv/dokitool/current/frontend/dist
        header @download_bridge Cache-Control "no-store"
        header @not_download_bridge Cache-Control "no-cache"
        file_server
    }
    # Exact SEO files must never fall through to the SPA, including when missing.
    handle /robots.txt {
        root * /srv/dokitool/current/frontend/dist
        header Content-Type "text/plain; charset=utf-8"
        header Cache-Control "no-cache"
        file_server
    }
    handle /sitemap.xml {
        root * /srv/dokitool/current/frontend/dist
        header Content-Type "application/xml; charset=utf-8"
        header Cache-Control "no-cache"
        file_server
    }
    handle /llms.txt {
        root * /srv/dokitool/current/frontend/dist
        header Content-Type "text/plain; charset=utf-8"
        header Cache-Control "no-cache"
        file_server
    }
    handle /social/dokitool-share-v1.png {
        root * /srv/dokitool/current/frontend/dist
        header Content-Type "image/png"
        header Cache-Control "no-cache"
        file_server
    }
    handle @monitor {
        root * /srv/dokitool/current/frontend/dist
        header Content-Type "text/html; charset=utf-8"
        header Cache-Control "no-store"
        header X-Robots-Tag "noindex, nofollow, noarchive"
        header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
        rewrite * /monitor.html
        file_server
    }
    handle {
        root * /srv/dokitool/current/frontend/dist
        route {
            # HTML and non-versioned files revalidate; API/media routes above are unaffected.
            header Cache-Control "no-cache"
            @versioned {
                path_regexp hashed ^/assets/[A-Za-z0-9_.-]+-[A-Za-z0-9_-]{8}\.(js|css|png|webp|svg|ico|woff2|ttf)(?:\.(?:br|gz))?$
                file {path}
            }
            header @versioned Cache-Control "public, max-age=31536000, immutable"
            # A missing chunk must return 404, never long-cache HTML as JavaScript.
            handle /assets/* {
                file_server {
                    precompressed br gzip
                }
            }
            # Serve only real static files (/ and /index.html included); return true 404 for unknown paths.
            @existing_static {
                file {path} {path}/index.html
            }
            handle @existing_static {
                file_server
            }
            handle {
                respond 404
            }
        }
    }
    }
}
