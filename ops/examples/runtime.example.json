{
  "schema_version": "1.0",
  "ytdlp": {
    "youtube_slots": 4,
    "youtube_queue_size": 32,
    "youtube_queue_wait": "20s",
    "social_slots": 4,
    "social_queue_size": 32,
    "social_queue_wait": "20s",
    "generic_slots": 2,
